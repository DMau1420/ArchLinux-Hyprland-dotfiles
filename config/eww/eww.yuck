(defwidget contenido_prueba []
	(box 	:orientation "h"
		:class "principal"
		(label	:text "hola no se que poner"
			:class "texto-libre"
		)
	)
)


(defvar current_month "")
(defvar current_year "")

(defwidget calen []
	(box :class "cal-box"
		:orientation "v"
		:space-evenly true


	(calendar :class "cal-widget" 
              :month {current_month == "" ? 0 : current_month - 1} 
              :year {current_year == "" ? 2026 : current_year}
              :show-details true)
	)
)

(defwindow calendario
	:monitor 0
	:stacking "fg"
	:focusable true
	:geometry (geometry 
		:x "0.5%"
		:y "1%"
		:anchor "top right"
		:width "300px"
	)
	(calen)
)

