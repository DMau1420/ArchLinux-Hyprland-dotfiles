{
	"layer": "top",
	"position": "top",
	"margin-top": 0,
	"margin-bottom": 1,
	"font": "FiraCode Nerd Font 10",

	//modules layout
	"modules-left": [
			"custom/launcher", 
			"hyprland/workspaces"
	],
	"modules-center": [
			"custom/mediaplayer", 
			"custom/previous", 
			"custom/reproducir", 
			"custom/next"
	],
	"modules-right": [
			"backlight", 
			"wireplumber", 
			"tray", 
			"cpu", 
			"memory", 
			"battery", 
			"clock",
			"hyprland/language"
	],

	//modules definition
	"custom/launcher": {
		"format": "󰣇",
		"tooltip": false,
		"on-click": "wlogout -b 6 -T 400 -B 400"
	},

	"hyprland/workspaces": {
		"format": "{icon} {id}",
		"format-icons": { 
			"active": "󰨇 ",
			"default": "󰍹 "
		}
	},
	
	"cpu": {
		"interval": 10,
		"format": "{usage}% "
	},

	"memory": {
		"interval": 10,
		"format": "{}%  "
	},

	"clock": {
        	"format": "{:%I:%M %p}",
		"tooltip": false,
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"on-click": "swaync-client -t -sw"
	},

	"battery": {
		"interval": 10,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{capacity}% {icon}",
		"format-charging": "{capacity}% 󱐋",
		"format-plugged": "{capacity}% 󱐥",
        	"format-icons": ["", "", "", "", ""],
		"tooltip-format": "{timeTo}"
    	},

	"wireplumber": {
		"format": "{volume}% {icon}",
		"format-muted": " ",
		"format-icons": [" ", " ", " "],
		"on-click": "wpctl set-mute @DEFAULT_SINK@ toggle"
	},

	"backlight": {
		"device": "intel_backlight",
		"format": "{percent} % {icon}",
		"format-icons": ["󰃞 ", "󰃝 ", "󰃟 ", "󰃠 "],
		"tooltip": false
	},

	"custom/mediaplayer": {
		"format": " {}",
		"exec": "python ~/.config/Scrips/mediaplayer.py",
		"return-type": "",
		"min-length": 45
	},

	"custom/reproducir": {
		"format": "{icon}",
        	"return-type": "json",
        	"exec": "playerctl -a metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        	"format-icons": {
			"Playing": "󰏤",
			"Paused": "󰐊"
        	},
		"on-click": "playerctl play-pause",
		"tooltip": false
	},

	"custom/previous": {
		"format": "󰒮",
		"on-click": "playerctl previous",
		"tooltip": false
	},

	"custom/next": {
		"format": "󰒭",
		"on-click": "playerctl next",
		"tooltip": false
	},

	"tray": {
		"spacing": 8
	},

	"hyprland/language": {
		"format": "{}",
		"format-en": "us",
		"format-es": "es"
	}
}
